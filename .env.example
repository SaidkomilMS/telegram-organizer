# Copy to .env and fill in. On the first start these are written into /data/settings.toml;
# after that the settings file wins (values here only fill blanks). Keep .env private.

# From https://my.telegram.org -> "API development tools"
TG_CURATOR_API_ID=
TG_CURATOR_API_HASH=

# From @BotFather: the bot that posts into your topic channels
TG_CURATOR_BOT_TOKEN=

# Optional: your timezone (IANA name). The digest and review hours are local to it; without it
# they are UTC until you pick a zone in /settings. Remove the # to use it.
# TG_CURATOR_TIMEZONE=Asia/Tashkent
